---
import { Image } from "astro:assets";
import aljezur from "../assets/aljezur.jpg";

const benefits = [
  {
    title: "Physical Fitness",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
  },
  {
    title: "Mental Well-being",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.54Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.54Z"/></svg>`,
  },
  {
    title: "Personal Growth",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>`,
  },
  {
    title: "Community",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];
---

<section
  id="about"
  class="scroll-mt-16 py-24 relative overflow-hidden bg-white/50 organic-pattern"
  aria-labelledby="about-heading"
>
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8">
        <div>
          <h2
            id="about-heading"
            class="text-4xl md:text-5xl font-display font-black mb-6 text-foreground leading-tight"
          >
            Mastering <span class="text-primary italic">Jiujitsu Fundamentals</span> in
            Aljezur
          </h2>
          <div class="w-20 h-2 bg-secondary rounded-full mb-8"></div>
        </div>

        <div
          class="space-y-6 text-lg text-muted-foreground leading-relaxed font-body"
        >
          <p>
            Located in the heart of Aljezur, <span
              class="text-foreground font-bold italic">Bear Bones Jiujitsu</span
            > is more than an academy—it's a hub for personal growth and technical
            excellence.
          </p>
          <p>
            Our philosophy is built on discipline, community, and hard work. We
            believe that through dedicated training, we build a stronger, more
            resilient future—on and off the mats.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-10">
          {
            benefits.map((item) => (
              <div class="group flex flex-col items-start p-6 rounded-3xl bg-white/60 border border-white/40 shadow-sm hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1 transition-all duration-300 backdrop-blur-sm">
                <div
                  class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
                  set:html={item.icon}
                />
                <h3 class="font-display font-bold text-foreground text-lg">
                  {item.title}
                </h3>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative group">
        <div
          class="absolute inset-0 bg-primary/10 rounded-[3rem] rotate-3 scale-105 transition-transform group-hover:rotate-1"
        >
        </div>
        <div
          class="absolute inset-0 bg-secondary/10 rounded-[3rem] -rotate-3 scale-105 transition-transform group-hover:-rotate-1"
        >
        </div>
        <Image
          src={aljezur}
          alt="Aljezur, Portugal"
          width={700}
          height={600}
          class="relative rounded-[3rem] shadow-2xl object-cover w-full aspect-square md:aspect-auto md:h-[600px] z-10"
        />
      </div>
    </div>
  </div>
</section>
