---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const adultsSchedule = [
  `${t("schedule.mon")}: ${t("schedule.adults.mon")}`,
  `${t("schedule.tue")}: ${t("schedule.adults.tue")}`,
  `${t("schedule.wed")}: ${t("schedule.adults.wed")}`,
  `${t("schedule.thu")}: ${t("schedule.adults.thu")}`,
  `${t("schedule.fri")}: ${t("schedule.adults.fri")}`,
];

const kidsSchedule = [
  `${t("schedule.mon")}: ${t("schedule.kids.mon")}`,
  `${t("schedule.tue")}: ${t("schedule.kids.tue")}`,
  `${t("schedule.thu")}: ${t("schedule.kids.thu")}`,
];
---

<section
  id="schedule"
  aria-labelledby="schedule-heading"
  class="scroll-mt-16 py-24 bg-muted/30 relative"
>
  <div class="container mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2
        id="schedule-heading"
        class="text-4xl md:text-5xl font-display font-black mb-4"
      >
        {t("schedule.title.prefix")}
        <span class="text-primary italic">{t("schedule.title.highlight")}</span>
      </h2>
      <p class="text-lg text-muted-foreground font-body">
        {t("schedule.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Adults Schedule -->
      <div class="group">
        <div
          class="glass p-8 md:p-10 rounded-[3rem] border-primary/20 hover:border-primary/40 transition-all duration-500 relative overflow-hidden h-full"
        >
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-primary/20 transition-all"
          >
          </div>

          <div class="flex items-center gap-4 mb-8">
            <div
              class="w-16 h-16 bg-primary text-primary-foreground rounded-2xl flex items-center justify-center shadow-lg"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                ></path><circle cx="9" cy="7" r="4"></circle><path
                  d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                  d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
              >
            </div>
            <div>
              <h3 class="text-3xl font-display font-black text-foreground">
                {t("schedule.adults.title")}
              </h3>
              <p
                class="text-primary font-bold uppercase tracking-widest text-xs mt-1"
              >
                {t("schedule.adults.duration")}
              </p>
            </div>
          </div>

          <div class="space-y-4">
            {
              adultsSchedule.map((time) => {
                const [day, details] = time.split(": ");
                return (
                  <div class="flex items-center justify-between py-3 border-b border-primary/5 last:border-0 hover:bg-primary/5 transition-colors rounded-xl px-4 -mx-4">
                    <span class="font-display font-black text-lg text-foreground w-12">
                      {day}
                    </span>
                    <span class="text-muted-foreground font-body text-right font-medium">
                      {details}
                    </span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>

      <!-- Kids Schedule -->
      <div class="group">
        <div
          class="glass p-8 md:p-10 rounded-[3rem] border-secondary/20 hover:border-secondary/40 transition-all duration-500 relative overflow-hidden h-full"
        >
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-secondary/10 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-secondary/20 transition-all"
          >
          </div>

          <div class="flex items-center gap-4 mb-8">
            <div
              class="w-16 h-16 bg-secondary text-secondary-foreground rounded-2xl flex items-center justify-center shadow-lg"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M12 7V3m0 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm0 0a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.5 10.5l-3.5-1.5m0 0l-1.5 2.5m1.5-2.5l1.5-3.5m12 7.5l3.5-1.5m0 0l1.5 2.5m-1.5-2.5l-1.5-3.5M12 11v4m0 0l-3 4m3-4l3 4"
                ></path></svg
              >
            </div>
            <div>
              <h3 class="text-3xl font-display font-black text-foreground">
                {t("schedule.kids.title")}
              </h3>
              <p
                class="text-secondary font-bold uppercase tracking-widest text-xs mt-1"
              >
                {t("schedule.kids.duration")}
              </p>
            </div>
          </div>

          <div class="space-y-4">
            {
              kidsSchedule.map((time) => {
                const [day, details] = time.split(": ");
                return (
                  <div class="flex items-center justify-between py-3 border-b border-secondary/5 last:border-0 hover:bg-secondary/5 transition-colors rounded-xl px-4 -mx-4">
                    <span class="font-display font-black text-lg text-foreground w-12">
                      {day}
                    </span>
                    <span class="text-muted-foreground font-body text-right font-medium">
                      {details}
                    </span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
