---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="home"
  class="relative min-h-screen flex items-start md:items-center justify-center text-foreground overflow-hidden pt-32 md:pt-20"
>
  <!-- Immersive Light Environment -->
  <div class="absolute inset-0 z-0">
    <!-- Main Sun Bloom -->
    <div
      class="absolute -top-[20%] -right-[10%] w-[80%] h-[80%] bg-secondary/30 blur-[150px] rounded-full animate-slow-pulse"
    >
    </div>
    <!-- Secondary Green Bloom -->
    <div
      class="absolute top-[20%] -left-[10%] w-[60%] h-[60%] bg-primary/10 blur-[120px] rounded-full rotate-45"
    >
    </div>
    <!-- Accent Teal Bloom -->
    <div
      class="absolute -bottom-[10%] right-[10%] w-[50%] h-[50%] bg-accent/10 blur-[100px] rounded-full"
    >
    </div>

    <!-- Animated Light Flares -->
    <div
      class="absolute top-1/4 left-1/3 w-2 h-2 bg-white rounded-full blur-md animate-float opacity-50"
    >
    </div>
    <div
      class="absolute top-1/2 right-1/4 w-3 h-3 bg-secondary/40 rounded-full blur-lg animate-float-delayed opacity-30"
    >
    </div>
  </div>

  <!-- Grainy Texture Overlay -->
  <div
    class="absolute inset-0 z-1 opacity-[0.03] pointer-events-none bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto text-center">
      <div
        class="inline-flex items-center gap-3 px-6 py-2.5 rounded-full bg-white/40 backdrop-blur-md border border-white/60 text-primary mb-8 animate-float shadow-xl shadow-primary/5"
      >
        <span class="relative flex h-3 w-3">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"
          ></span>
        </span>
        <span class="text-xs font-black uppercase tracking-[0.2em]"
          >{t("hero.tagline")}</span
        >
      </div>

      <h1
        class="text-7xl md:text-9xl font-display font-black mb-8 text-foreground leading-[0.85] tracking-tighter"
      >
        {t("hero.title.part1")}
        <br />
        <span
          class="text-[0.75em] text-primary font-body font-black uppercase tracking-tight relative inline-block"
        >
          {t("hero.title.part2")}
          <svg
            class="absolute -bottom-2 left-0 w-full h-4 text-secondary/30 -z-10"
            viewBox="0 0 100 20"
            preserveAspectRatio="none"
          >
            <path
              d="M0 10 Q 25 20 50 10 T 100 10"
              stroke="currentColor"
              stroke-width="4"
              fill="transparent"></path>
          </svg>
        </span>
      </h1>

      <p
        class="text-xl md:text-2xl mb-12 text-muted-foreground font-body max-w-2xl mx-auto leading-relaxed text-balance"
      >
        {t("hero.description")}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a
          href="#contact"
          class="group relative inline-flex items-center justify-center px-10 py-5 bg-primary text-primary-foreground font-black rounded-2xl shadow-[0_20px_50px_rgba(45,90,39,0.3)] hover:shadow-[0_20px_50px_rgba(45,90,39,0.5)] hover:-translate-y-1.5 active:translate-y-0 transition-all duration-300 scroll-link overflow-hidden uppercase tracking-widest text-sm"
        >
          <div
            class="absolute inset-0 bg-linear-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
          >
          </div>
          <span class="relative z-10">{t("hero.cta.start")}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 ml-2 relative z-10 group-hover:translate-x-1 transition-transform"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href="#schedule"
          class="px-10 py-5 bg-white/40 backdrop-blur-xl border border-white/60 text-foreground font-black rounded-2xl hover:bg-white/80 hover:-translate-y-1.5 active:translate-y-0 shadow-lg shadow-black/5 transition-all duration-300 scroll-link uppercase tracking-widest text-sm"
        >
          {t("hero.cta.schedule")}
        </a>
      </div>
    </div>
  </div>

  <!-- Dynamic Organic Shapes -->
  <div
    class="absolute bottom-0 left-0 w-full h-48 bg-linear-to-t from-background via-background/80 to-transparent z-20 pointer-events-none"
  >
  </div>

  <div
    class="absolute right-[-5%] bottom-10 w-[400px] h-[400px] opacity-[0.07] pointer-events-none animate-slow-spin"
  >
    <svg
      viewBox="0 0 200 200"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full text-primary"
    >
      <path
        fill="currentColor"
        d="M44.7,-76.4C58.2,-69.2,70,-58.5,78.2,-45.6C86.3,-32.8,90.8,-17.9,89.5,-3.6C88.2,10.7,81.1,24.4,72.1,36.5C63,48.6,52,59.1,39.6,66.6C27.2,74.1,13.6,78.6,-0.5,79.5C-14.6,80.4,-29.2,77.7,-42.6,70.9C-56.1,64.1,-68.3,53.2,-76.3,40C-84.3,26.8,-88.1,11.3,-86.7,-3.8C-85.3,-18.8,-78.7,-33.4,-69,-45.6C-59.3,-57.8,-46.5,-67.6,-33.1,-74.9C-19.7,-82.1,-9.8,-86.9,2.4,-91.1C14.7,-95.2,29.3,-98.7,40.7,-93.2L44.7,-76.4Z"
        transform="translate(100 100)"></path>
    </svg>
  </div>
</section>

<style>
  @keyframes slow-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.1);
    }
  }
  @keyframes slow-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-slow-pulse {
    animation: slow-pulse 8s ease-in-out infinite;
  }
  .animate-slow-spin {
    animation: slow-spin 60s linear infinite;
  }
  .animate-float-delayed {
    animation: float 6s ease-in-out infinite 3s;
  }
</style>
