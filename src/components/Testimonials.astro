---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const testimonials = [
  {
    text: t("testimonials.1.text"),
    author: t("testimonials.1.author"),
  },
  {
    text: t("testimonials.2.text"),
    author: t("testimonials.2.author"),
  },
  {
    text: t("testimonials.3.text"),
    author: t("testimonials.3.author"),
  },
];
---

<section
  id="testimonials"
  aria-labelledby="testimonials-heading"
  class="scroll-mt-16 py-24 relative overflow-hidden bg-background organic-pattern"
>
  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2
        id="testimonials-heading"
        class="text-4xl md:text-5xl font-display font-black mb-4"
      >
        {t("testimonials.title.prefix")}
        <span class="text-primary italic"
          >{t("testimonials.title.highlight")}</span
        >
      </h2>
      <p class="text-lg text-muted-foreground font-body">
        {t("testimonials.subtitle")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        testimonials.map((testimonial) => (
          <article class="h-full">
            <div class="glass h-full p-8 rounded-[2.5rem] flex flex-col justify-between hover:scale-[1.02] transition-all duration-300 relative group border-white/60">
              {/* Quote Icon */}
              <div class="absolute -top-4 -left-4 w-12 h-12 bg-secondary rounded-2xl flex items-center justify-center text-secondary-foreground shadow-lg rotate-[-15deg] group-hover:rotate-0 transition-transform duration-300">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <>
                    <path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H11.017C10.4647 12 10.017 11.5523 10.017 11V5C10.017 3.89543 10.9124 3 12.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017Z" />
                    <path d="M1 21L1 18C1 16.8954 1.89543 16 3 16H6C6.55228 16 7 15.5523 7 15V9C7 8.44772 6.55228 8 6 8H2C1.44772 8 1 8.44772 1 9V11C1 11.5523 0.552285 12 0 12H-2C-2.55228 12 -3 11.5523 -3 11V5C-3 3.89543 -2.10457 3 -1 3H6C8.20914 3 10 4.79086 10 7V15C10 18.3137 7.31371 21 4 21H1Z" />
                  </>
                </svg>
              </div>

              <blockquote class="text-xl leading-relaxed text-foreground font-display font-medium mb-8">
                "{testimonial.text}"
              </blockquote>

              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-linear-to-br from-primary to-accent flex items-center justify-center text-white font-black">
                  {testimonial.author.charAt(0)}
                </div>
                <cite class="not-italic">
                  <div class="font-display font-bold text-foreground">
                    {testimonial.author.split(",")[0]}
                  </div>
                  <div class="text-sm text-primary font-bold uppercase tracking-wider">
                    {testimonial.author.split(",")[1] || "Student"}
                  </div>
                </cite>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
