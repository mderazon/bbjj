---
import { languages } from "../i18n/ui";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<div class="flex gap-2 language-picker">
  {
    Object.keys(languages).map((langCode) => (
      <a
        href={translatePath("/", langCode)}
        data-lang={langCode}
        class={`text-sm font-medium transition-colors hover:text-primary ${lang === langCode ? "text-primary font-bold" : "text-muted-foreground"}`}
      >
        {langCode.toUpperCase()}
      </a>
    ))
  }
</div>

<script>
  const pickers = document.querySelectorAll(".language-picker");
  pickers.forEach((picker) => {
    picker.addEventListener("click", (e) => {
      // @ts-ignore
      const link = e.target.closest("a");
      if (link && link.dataset.lang) {
        localStorage.setItem("language", link.dataset.lang);
      }
    });
  });
</script>
