{
  "name": "bbbjj",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "minify:scripts": "esbuild src/scripts/*.ts --minify --outdir=public/scripts/ --format=iife",
    "build": "npm run minify:scripts && astro build",
    "preview": "npm run minify:scripts && astro preview",
    "astro": "astro",
    "deploy": "npm run minify:scripts && astro build && wrangler deploy",
    "check": "astro check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/outfit": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.6",
    "lightningcss": "^1.32.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "esbuild": "^0.28.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  }
}
