{
  "name": "bbbjj",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "minify:scripts": "esbuild src/scripts/*.ts --minify --outdir=public/scripts/ --format=iife",
    "build": "npm run minify:scripts && astro build",
    "preview": "npm run minify:scripts && astro preview",
    "astro": "astro",
    "deploy": "npm run minify:scripts && astro build && wrangler deploy",
    "check": "astro check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "lightningcss": "1.33.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "esbuild": "0.28.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "wrangler": "4.115.0"
  }
}
