---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import AcademyVibe from "../components/AcademyVibe.astro";
import Testimonials from "../components/Testimonials.astro";
import Schedule from "../components/Schedule.astro";
import Instructor from "../components/Instructor.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <script is:inline>
    // Check for saved language preference or browser preference
    const savedLang = localStorage.getItem("language");
    const browserLang = navigator.language || navigator.userLanguage;

    // Redirect to Portuguese if preferred and not already there
    // This script only runs on the English (root) page
    if (savedLang === "pt" || (!savedLang && browserLang?.startsWith("pt"))) {
      window.location.replace("/pt/");
    }
  </script>
  <div class="min-h-screen">
    <Header />
    <main>
      <Hero />
      <About />
      <AcademyVibe />
      <Testimonials />
      <Schedule />
      <Instructor />
      <Contact />
    </main>
    <Footer />
  </div>
</Layout>
